@model Shooping.Data.Entities.Country

@{
    ViewData["Title"] = "Details";
}

<h1>Detalles del País</h1>

<div>
    <partial name="_CountryDetails" />
</div>
<div>
    <a asp-action="AddState" asp-route-id="@Model?.Id" class="btn btn-outline-primary me-3">Agregar Departamento/Estado</a>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-outline-warning me-3">Editar País</a>
    <a asp-action="Index" class="btn btn-outline-info">Regresar</a>
</div>
