@model Shooping.Models.CityViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Crear</h1>

<h4>Ciudad</h4>
<hr />
<div class="row">
    <div class="col-md-12">
        <form asp-action="AddCity">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="StateId" />
            <partial name="_City" />
            <br />
            <div class="form-group mt-2">
            <br />
                <input type="submit" value="Crear" class="btn btn-outline-primary me-3" />
                <a asp-action="DetailsState" asp-route-id="@Model.StateId" class=" btn btn-outline-success">Regresar</a>
            </div>
        </form>
    </div>
</div>

<div>
</div>
